          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH filtered AS (SELECT active_stage_duration_seconds FROM v_transfer_package_metrics WHERE $__timeFilter(processing_completed_time) AND active_stage_duration_seconds IS NOT NULL), ordered AS (SELECT active_stage_duration_seconds, ROW_NUMBER() OVER (ORDER BY active_stage_duration_seconds) AS rn, COUNT(*) OVER () AS cnt FROM filtered) SELECT ROUND((SELECT AVG(active_stage_duration_seconds) FROM filtered), 1) AS avg_active_stage_seconds, ROUND((SELECT AVG(active_stage_duration_seconds) FROM ordered WHERE rn IN (FLOOR((cnt + 1) / 2), FLOOR((cnt + 2) / 2))), 1) AS median_active_stage_seconds",
          "refId": "A"
        }
      ],
