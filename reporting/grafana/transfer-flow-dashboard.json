          "rawQuery": true,
          "rawSql": "SELECT 'Fetch' AS stage, ROUND(AVG(fetch_duration_seconds), 1) AS avg_seconds FROM v_transfer_package_metrics WHERE $__timeFilter(processing_completed_time) UNION ALL SELECT 'Checksum' AS stage, ROUND(AVG(checksum_duration_seconds), 1) AS avg_seconds FROM v_transfer_package_metrics WHERE $__timeFilter(processing_completed_time) UNION ALL SELECT 'RAWcooked' AS stage, ROUND(AVG(rawcooked_duration_seconds), 1) AS avg_seconds FROM v_transfer_package_metrics WHERE $__timeFilter(processing_completed_time) UNION ALL SELECT 'E-ARK' AS stage, ROUND(AVG(eark_duration_seconds), 1) AS avg_seconds FROM v_transfer_package_metrics WHERE $__timeFilter(processing_completed_time) UNION ALL SELECT 'Active stage total' AS stage, ROUND(AVG(active_stage_duration_seconds), 1) AS avg_seconds FROM v_transfer_package_metrics WHERE $__timeFilter(processing_completed_time)",
          "refId": "A"
        }
      ],
      "title": "Average stage durations",
      "type": "table"
